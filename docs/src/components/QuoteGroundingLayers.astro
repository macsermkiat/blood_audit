---
interface Layer {
  name: string;
  purpose: string;
  optional?: boolean;
}

interface Props {
  layers?: Layer[];
}

const isThai = Astro.url.pathname.includes("/th/");

const englishLayers: Layer[] = [
  { name: "Source ID", purpose: "The cited ID must resolve to exactly one source document in the evidence bundle." },
  { name: "NFC normalization", purpose: "The verifier normalizes the quote and source to Unicode NFC before comparing text." },
  { name: "Minimum length", purpose: "The normalized quote must contain at least 25 characters by default." },
  { name: "Contiguous match", purpose: "The quote must appear as a word-aligned contiguous substring in the cited source." },
  { name: "Within-document uniqueness", purpose: "The quote must occur at exactly one aligned position in that source." },
  { name: "Lab-tuple agreement", purpose: "Supported analyte, value, and unit triples must agree. A supplied lab tuple must match the quote itself." },
  {
    name: "NLI entailment",
    purpose: "A caller-supplied nli_gate compares the normalized source as premise with the normalized quote as hypothesis. The default application omits this check.",
    optional: true,
  },
];

const thaiLayers: Layer[] = [
  { name: "Source ID", purpose: "ID ที่อ้างต้องตรงกับเอกสารต้นฉบับเพียงหนึ่งรายการในชุดหลักฐาน" },
  { name: "NFC normalization", purpose: "verifier ปรับ quote และต้นฉบับเป็น Unicode NFC ก่อนเทียบข้อความ" },
  { name: "ความยาวขั้นต่ำ", purpose: "quote หลัง normalize ต้องมีอย่างน้อย 25 ตัวอักษรตามค่าปกติ" },
  { name: "ข้อความต่อเนื่อง", purpose: "quote ต้องปรากฏเป็นข้อความต่อเนื่องที่ตรงขอบเขตคำในต้นฉบับที่อ้าง" },
  { name: "ความไม่ซ้ำในเอกสาร", purpose: "quote ต้องพบเพียงหนึ่งตำแหน่งที่ตรงขอบเขตคำในต้นฉบับนั้น" },
  { name: "Lab tuple ตรงกัน", purpose: "ชุด analyte, value และ unit ที่รองรับต้องตรงกัน lab tuple ที่ให้มาต้องตรงกับ quote เองด้วย" },
  {
    name: "NLI entailment",
    purpose: "nli_gate ที่ผู้เรียกส่งเข้ามาเทียบต้นฉบับเป็น premise กับ quote เป็น hypothesis หลัง normalize แอปพลิเคชันปกติไม่เปิดการตรวจนี้",
    optional: true,
  },
];

const defaultLayers = isThai ? thaiLayers : englishLayers;
const { layers = defaultLayers } = Astro.props;
---

<section class="grounding-layers" aria-label={isThai ? "Quote-grounding stack: 6 ชั้นบังคับและ NLI gate แบบ optional" : "Quote-grounding stack: 6 mandatory layers plus an optional NLI gate"}>
  <p class="grounding-layers__intro">
    {isThai ? (
      <>
        verifier ปฏิเสธ quote ว่างก่อน แล้วตรวจตามลำดับด้านล่าง
        และหยุดที่ข้อแรกที่ไม่ผ่าน citation ที่ผ่านต้องผ่านทุกข้อที่เกี่ยวข้อง
        หากไม่มีความพยายามใดผ่าน pipeline จะให้
        <code>NEEDS_REVIEW</code> พร้อมเหตุผล
        <code>hallucination_suspect</code>. NLI เปิดเฉพาะเมื่อผู้เรียกส่ง gate เข้ามา
      </>
    ) : (
      <>
        The verifier rejects empty quotes, then checks the layers below until
        the first failure. A passing citation satisfies every applicable check.
        If no attempt passes verification, the pipeline writes
        <code>NEEDS_REVIEW</code> with <code>hallucination_suspect</code>.
        NLI runs only when the caller supplies a gate.
      </>
    )}
  </p>
  <ol class="grounding-layers__list" role="list">
    {layers.map((layer, idx) => (
      <li class:list={["grounding-layer", { "grounding-layer--optional": layer.optional }]}>
        <span class="grounding-layer__index" aria-hidden="true">
          {String(idx + 1).padStart(2, "0")}
        </span>
        <div class="grounding-layer__body">
          <div class="grounding-layer__head">
            <p class="grounding-layer__name">{layer.name}</p>
            {layer.optional && <span class="ba-pill ba-pill--warn">{isThai ? "เปิดใช้เมื่อกำหนด" : "opt-in"}</span>}
          </div>
          <p class="grounding-layer__purpose">{layer.purpose}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .grounding-layers {
    margin: 1.25rem 0;
  }
  .grounding-layers__intro {
    margin: 0 0 0.875rem;
    max-width: 70ch;
  }
  .grounding-layers__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .grounding-layer {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.875rem;
    padding: 0.75rem 0.875rem 0.875rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-bg-nav);
    transition: border-color var(--ba-duration-fast) var(--ba-ease-out);
  }
  .grounding-layer:hover {
    border-color: var(--sl-color-gray-4);
  }
  .grounding-layer--optional {
    border-style: dashed;
    background: transparent;
  }
  .grounding-layer__index {
    font-family: var(--ba-font-mono);
    font-size: 1rem;
    font-weight: 700;
    color: var(--sl-color-accent);
    line-height: 1.4;
  }
  .grounding-layer__body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .grounding-layer__head {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    flex-wrap: wrap;
  }
  .grounding-layer__name {
    margin: 0;
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .grounding-layer__purpose {
    margin: 0;
    color: var(--sl-color-gray-2);
    line-height: 1.55;
  }
  @media (prefers-reduced-motion: reduce) {
    .grounding-layer {
      transition: none;
    }
  }
</style>
