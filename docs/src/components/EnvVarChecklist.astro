---
interface EnvVar {
  name: string;
  example: string;
  purpose: string;
  requiredFor: string;
}

interface Props {
  vars?: EnvVar[];
}

const isThai = Astro.url.pathname.includes("/th/");
const defaultVars: EnvVar[] = [
  {
    name: "BBA_DATA_DIR",
    example: "/srv/bba/data",
    purpose: isThai
      ? "พื้นที่ถาวรที่จำกัดสิทธิ์สำหรับผลการตรวจ snapshot และ identity.key"
      : "Private persistent storage for audit results, source snapshots, and identity.key.",
    requiredFor: isThai ? "ตรวจแบบ local" : "local audit",
  },
  {
    name: "BBA_APPLICATION_CONFIG",
    example: "/srv/bba/config/application.json",
    purpose: isThai
      ? "ไฟล์ JSON สำหรับ policy version และ transport ค่าเริ่มต้นใช้โหมด local"
      : "JSON policy version and transport settings. The default transport is local.",
    requiredFor: isThai ? "ตั้งค่าโมเดล" : "configured model review",
  },
  {
    name: "BBA_PRIVACY_POLICY",
    example: "/srv/bba/config/privacy-policy.json",
    purpose: isThai
      ? "นโยบายที่ระบุ public key และ redactor ที่อนุมัติ"
      : "Trust policy naming the verification public key and approved redactor.",
    requiredFor: isThai ? "ส่งหลักฐานให้โมเดล" : "model admission",
  },
  {
    name: "BBA_PRIVACY_ARTIFACTS",
    example: "/srv/bba/admission/artifacts.json",
    purpose: isThai
      ? "หลักฐานที่ลบข้อมูลแล้วและ attestation ที่ลงลายมือชื่อ แยกตาม audit ID"
      : "Exact redacted evidence and signed attestations keyed by audit ID.",
    requiredFor: isThai ? "ส่งหลักฐานให้โมเดล" : "model admission",
  },
  {
    name: "BBA_DB_URL",
    example: "postgresql://bba@localhost/blood_audit",
    purpose: isThai
      ? "Postgres ที่ทำ migration แล้วสำหรับ model checkpoint หรือ review actions ใช้บัญชีและสิทธิ์ตามงาน"
      : "Migrated Postgres for model checkpoints or review actions, using the role required for that task.",
    requiredFor: isThai ? "โมเดลหรือ dashboard" : "model review or dashboard",
  },
  {
    name: "ANTHROPIC_API_KEY",
    example: isThai ? "ส่งผ่านระบบ secret" : "supplied through secret storage",
    purpose: isThai
      ? "ใช้เฉพาะ transport แบบ live อย่าแสดงค่าใน log หรือภาพหน้าจอ"
      : "Used only by live transport. Keep the value out of logs and screenshots.",
    requiredFor: isThai ? "โมเดล live" : "live transport",
  },
];
const { vars = defaultVars } = Astro.props;
---

<section class="env-checklist" aria-label={isThai ? "ตัวแปรแวดล้อมหลัก" : "Core environment settings"}>
  <ul class="env-checklist__list" role="list">
    {vars.map((v) => (
      <li class="env-row">
        <div class="env-row__head">
          <code class="env-row__name">{v.name}</code>
          <span class="ba-pill">{v.requiredFor}</span>
        </div>
        <p class="env-row__purpose">{v.purpose}</p>
        <code class="env-row__example" aria-label={isThai ? "ค่าตัวอย่าง" : "Example value"}>{v.example}</code>
      </li>
    ))}
  </ul>
</section>

<style>
  .env-checklist {
    margin: 1.25rem 0;
  }
  .env-checklist__list {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .env-row {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    padding: 0.75rem 0.875rem 0.875rem;
    background: var(--sl-color-bg-nav);
    transition: border-color var(--ba-duration-fast) var(--ba-ease-out);
  }
  .env-row:hover {
    border-color: var(--sl-color-gray-4);
  }
  .env-row__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.375rem;
    flex-wrap: wrap;
  }
  .env-row__name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--sl-color-white);
    letter-spacing: 0;
  }
  .env-row__purpose {
    margin: 0 0 0.5rem;
    font-size: 0.9375rem;
    color: var(--sl-color-gray-2);
    line-height: 1.55;
  }
  .env-row__example {
    display: block;
    padding: 0.375rem 0.5rem;
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-gray-6);
    border-radius: 0.3125rem;
    font-size: 0.8125rem;
    color: var(--sl-color-gray-2);
    word-break: break-all;
    line-height: 1.4;
  }
  @media (prefers-reduced-motion: reduce) {
    .env-row {
      transition: none;
    }
  }
</style>
