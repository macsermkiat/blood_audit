---
interface Step {
  index: string;
  question: string;
  evidence: string;
  yes: string;
  route: "Final" | "LLM" | "Conditional";
  tone: "ok" | "warn" | "err";
  otherwise: string;
}

const isThai = Astro.url.pathname.includes("/th/");

const englishSteps: Step[] = [
  {
    index: "1",
    question: "No usable pre-order Hb?",
    evidence: "Selected Hb from the seven-day lookup",
    yes: "INSUFFICIENT_EVIDENCE",
    route: "Final",
    tone: "warn",
    otherwise: "Check the universal Hb rule",
  },
  {
    index: "2",
    question: "Hb ≤ 7.0 g/dL?",
    evidence: "Selected pre-order Hb",
    yes: "APPROPRIATE",
    route: "Final",
    tone: "ok",
    otherwise: "Check MTP",
  },
  {
    index: "3",
    question: "MTP cohort?",
    evidence: "RBC order cluster and co-ordered components",
    yes: "APPROPRIATE",
    route: "Final",
    tone: "ok",
    otherwise: "Check unknown context",
  },
  {
    index: "4",
    question: "Unknown cohort?",
    evidence: "Procedure data unavailable",
    yes: "NEEDS_REVIEW",
    route: "LLM",
    tone: "warn",
    otherwise: "Check the Hb drop",
  },
  {
    index: "5",
    question: "Delta-Hb trigger met?",
    evidence: "Drop of ≥ 1.5 / 2.0 / 2.5 g/dL in 6 / 12 / 24 h",
    yes: "APPROPRIATE",
    route: "Final",
    tone: "ok",
    otherwise: "Check whether a cohort threshold exists",
  },
  {
    index: "6",
    question: "No numeric cohort threshold?",
    evidence: "Remaining active haematology context",
    yes: "NEEDS_REVIEW",
    route: "LLM",
    tone: "warn",
    otherwise: "Compare Hb with the cohort threshold",
  },
  {
    index: "7",
    question: "Hb ≤ cohort threshold?",
    evidence: "Threshold plus crystalloid and isolated-Hb checks",
    yes: "APPROPRIATE, or NEEDS_REVIEW if a safety flag applies",
    route: "Conditional",
    tone: "warn",
    otherwise: "Check the remaining Hb range",
  },
  {
    index: "8",
    question: "Hb < 10 g/dL?",
    evidence: "Hb above the cohort threshold",
    yes: "NEEDS_REVIEW",
    route: "LLM",
    tone: "warn",
    otherwise: "Check the high-Hb rule",
  },
  {
    index: "9",
    question: "Hb ≥ 10 g/dL?",
    evidence: "No earlier rule has applied",
    yes: "POTENTIALLY_INAPPROPRIATE",
    route: "LLM",
    tone: "err",
    otherwise: "Not reached for a valid Hb",
  },
];

const thaiSteps: Step[] = [
  {
    index: "1",
    question: "ไม่มี Hb ก่อนสั่งที่ใช้ได้?",
    evidence: "Hb ที่เลือกจากการค้นย้อนหลังเจ็ดวัน",
    yes: "INSUFFICIENT_EVIDENCE",
    route: "Final",
    tone: "warn",
    otherwise: "ตรวจกฎ Hb หลัก",
  },
  {
    index: "2",
    question: "Hb ≤ 7.0 g/dL?",
    evidence: "ค่า Hb ก่อนสั่งที่เลือกไว้",
    yes: "APPROPRIATE",
    route: "Final",
    tone: "ok",
    otherwise: "ตรวจ MTP",
  },
  {
    index: "3",
    question: "เข้า cohort MTP?",
    evidence: "กลุ่มคำสั่ง RBC และส่วนประกอบที่สั่งร่วม",
    yes: "APPROPRIATE",
    route: "Final",
    tone: "ok",
    otherwise: "ตรวจบริบทที่ไม่ทราบ",
  },
  {
    index: "4",
    question: "ไม่ทราบ cohort?",
    evidence: "ไม่มีข้อมูลหัตถการให้ตรวจ",
    yes: "NEEDS_REVIEW",
    route: "LLM",
    tone: "warn",
    otherwise: "ตรวจการลดลงของ Hb",
  },
  {
    index: "5",
    question: "Hb ลดถึงเกณฑ์?",
    evidence: "ลด ≥ 1.5 / 2.0 / 2.5 g/dL ใน 6 / 12 / 24 ชั่วโมง",
    yes: "APPROPRIATE",
    route: "Final",
    tone: "ok",
    otherwise: "ตรวจว่ามีเกณฑ์ตัวเลขของ cohort หรือไม่",
  },
  {
    index: "6",
    question: "ไม่มีเกณฑ์ตัวเลขของ cohort?",
    evidence: "บริบทโลหิตวิทยาที่ยังเหลืออยู่",
    yes: "NEEDS_REVIEW",
    route: "LLM",
    tone: "warn",
    otherwise: "เทียบ Hb กับเกณฑ์ cohort",
  },
  {
    index: "7",
    question: "Hb ≤ เกณฑ์ cohort?",
    evidence: "พิจารณาร่วมกับ crystalloid และ Hb ต่ำที่ไม่มีแนวโน้ม",
    yes: "APPROPRIATE หรือ NEEDS_REVIEW หากมี safety flag",
    route: "Conditional",
    tone: "warn",
    otherwise: "ตรวจช่วง Hb ที่เหลือ",
  },
  {
    index: "8",
    question: "Hb < 10 g/dL?",
    evidence: "Hb สูงกว่าเกณฑ์ cohort",
    yes: "NEEDS_REVIEW",
    route: "LLM",
    tone: "warn",
    otherwise: "ตรวจกฎ Hb สูง",
  },
  {
    index: "9",
    question: "Hb ≥ 10 g/dL?",
    evidence: "ไม่เข้าเงื่อนไขก่อนหน้า",
    yes: "POTENTIALLY_INAPPROPRIATE",
    route: "LLM",
    tone: "err",
    otherwise: "ไม่เกิดขึ้นสำหรับ Hb ที่ใช้ได้",
  },
];

const steps = isThai ? thaiSteps : englishSteps;

const routeLabel = (route: Step["route"]) => {
  if (!isThai) return route === "Conditional" ? "Final or review" : route;
  return route === "Final" ? "จบโดยกฎ" : route === "Conditional" ? "จบหรือส่งทบทวน" : "ส่งทบทวนผ่าน LLM";
};
---

<figure class="algorithm-flow" aria-labelledby="algorithm-flow-title">
  <figcaption id="algorithm-flow-title" class="algorithm-flow__caption">
    {isThai ? (
      <>
        ลำดับกฎเริ่มต้นหลังการตรวจระดับคำสั่ง ผลแรกที่เข้าเงื่อนไขเป็นผลของคำสั่ง
        เส้นทาง LLM ต้องผ่านการตรวจความเป็นส่วนตัวและการตั้งค่าที่อนุญาต
      </>
    ) : (
      <>
        Default rule order after order-level routing. The first matching result applies.
        LLM review requires privacy admission and an enabled transport.
      </>
    )}
  </figcaption>

  <div class="algorithm-flow__start">
    <span class="algorithm-flow__eyebrow">{isThai ? "ข้อมูลเข้า" : "Inputs"}</span>
    <strong>
      {isThai
        ? "คำสั่ง RBC ผล Hb บริบท cohort และประวัติ crystalloid"
        : "RBC order, Hb lookup, cohort, and crystalloid history"}
    </strong>
  </div>

  <ol class="algorithm-flow__steps">
    {steps.map((step) => (
      <li class="algorithm-flow__step">
        <div class="algorithm-flow__node">
          <span class="algorithm-flow__index">{step.index}</span>
          <span class="algorithm-flow__node-copy">
            <span class="algorithm-flow__question">{step.question}</span>
            <span class="algorithm-flow__evidence">{step.evidence}</span>
          </span>
        </div>
        <div class="algorithm-flow__branches">
          <div class="algorithm-flow__branch algorithm-flow__branch--yes" data-tone={step.tone}>
            <span class="algorithm-flow__branch-label">{isThai ? "ใช่" : "Yes"}</span>
            <strong>{step.yes}</strong>
            <span class="algorithm-flow__route">{routeLabel(step.route)}</span>
          </div>
          <div class="algorithm-flow__branch algorithm-flow__branch--no">
            <span class="algorithm-flow__branch-label">{isThai ? "ไม่ใช่" : "No"}</span>
            <span>{step.otherwise}</span>
          </div>
        </div>
      </li>
    ))}
  </ol>

  <div class="algorithm-flow__footer">
    <span class="ba-pill ba-pill--ok">{isThai ? "จบโดยไม่เรียก LLM" : "Final without LLM"}</span>
    <span class="ba-pill ba-pill--warn">{isThai ? "เส้นทาง LLM review" : "LLM review route"}</span>
    <span class="ba-pill ba-pill--err">{isThai ? "Hb สูง น่ากังวล" : "High-Hb concern"}</span>
  </div>
</figure>

<style>
  .algorithm-flow {
    margin: 1.5rem 0;
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-bg-nav);
  }

  .algorithm-flow__caption {
    margin: 0 0 1rem;
    color: var(--sl-color-gray-2);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .algorithm-flow__start {
    display: grid;
    gap: 0.25rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--sl-color-accent);
    border-radius: 0.5rem;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
  }

  .algorithm-flow__eyebrow,
  .algorithm-flow__branch-label,
  .algorithm-flow__route {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .algorithm-flow__eyebrow {
    color: var(--sl-color-accent-high);
  }

  .algorithm-flow__steps {
    display: grid;
    gap: 0.75rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .algorithm-flow__step {
    display: grid;
    grid-template-columns: minmax(12rem, 0.9fr) minmax(16rem, 1.4fr);
    gap: 0.75rem;
    align-items: stretch;
    position: relative;
  }

  .algorithm-flow__step + .algorithm-flow__step::before {
    content: "";
    position: absolute;
    top: -0.75rem;
    left: 1.25rem;
    width: 1px;
    height: 0.75rem;
    background: var(--sl-color-gray-5);
  }

  .algorithm-flow__node {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.625rem;
    align-items: center;
    min-height: 4.25rem;
    padding: 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-bg);
  }

  .algorithm-flow__index {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-accent-high);
    font-family: var(--ba-font-mono);
    font-weight: 700;
  }

  .algorithm-flow__question {
    color: var(--sl-color-white);
    font-weight: 700;
    line-height: 1.35;
  }

  .algorithm-flow__node-copy {
    display: grid;
    gap: 0.25rem;
  }

  .algorithm-flow__evidence {
    color: var(--sl-color-gray-3);
    font-size: 0.78rem;
    line-height: 1.35;
  }

  .algorithm-flow__branches {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.82fr);
    gap: 0.5rem;
  }

  .algorithm-flow__branch {
    display: grid;
    gap: 0.25rem;
    min-height: 4.25rem;
    padding: 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-gray-2);
  }

  .algorithm-flow__branch strong {
    color: var(--sl-color-white);
    font-size: 0.93rem;
    line-height: 1.35;
  }

  .algorithm-flow__branch--yes[data-tone="ok"] {
    border-color: oklch(70% 0.10 150);
    background: oklch(96% 0.025 150);
  }

  .algorithm-flow__branch--yes[data-tone="warn"] {
    border-color: oklch(72% 0.11 70);
    background: oklch(96% 0.035 70);
  }

  .algorithm-flow__branch--yes[data-tone="err"] {
    border-color: oklch(70% 0.13 28);
    background: oklch(96% 0.035 28);
  }

  :root[data-theme="dark"] .algorithm-flow__branch--yes[data-tone="ok"] {
    border-color: oklch(55% 0.12 150);
    background: oklch(24% 0.045 150);
  }

  :root[data-theme="dark"] .algorithm-flow__branch--yes[data-tone="warn"] {
    border-color: oklch(56% 0.12 70);
    background: oklch(25% 0.05 70);
  }

  :root[data-theme="dark"] .algorithm-flow__branch--yes[data-tone="err"] {
    border-color: oklch(56% 0.13 28);
    background: oklch(25% 0.055 28);
  }

  .algorithm-flow__route {
    color: var(--sl-color-gray-3);
  }

  .algorithm-flow__footer {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  @media (max-width: 50rem) {
    .algorithm-flow {
      padding: 0.75rem;
    }

    .algorithm-flow__step {
      grid-template-columns: 1fr;
    }

    .algorithm-flow__branches {
      grid-template-columns: 1fr;
    }

    .algorithm-flow__step + .algorithm-flow__step::before {
      left: 1rem;
    }
  }
</style>
