---
interface Tier {
  label: string;
  range: string;
  ruleOutput: "APPROPRIATE" | "NEEDS_REVIEW" | "POTENTIALLY_INAPPROPRIATE";
  routes: "auto-classify" | "LLM review";
  rule: string;
}

interface Props {
  tiers?: Tier[];
}

const isThai = Astro.url.pathname.includes("/th/");

const englishTiers: Tier[] = [
  {
    label: "Tier 1",
    range: "Hb ≤ 7.0 globally, or 7.0 < Hb ≤ cohort threshold",
    ruleOutput: "APPROPRIATE",
    routes: "auto-classify",
    rule: "Hb ≤ 7.0 returns APPROPRIATE before MTP or unknown-cohort checks. Above 7.0, Hb at or below the cohort threshold clears unless hemodilution or an isolated low Hb requires review.",
  },
  {
    label: "Tier 2",
    range: "cohort threshold < Hb < 10 g/dL",
    ruleOutput: "NEEDS_REVIEW",
    routes: "LLM review",
    rule: "Above the cohort threshold and below 10.0, the classifier returns NEEDS_REVIEW unless an earlier routing rule applies.",
  },
  {
    label: "Tier 3",
    range: "Hb ≥ 10 g/dL",
    ruleOutput: "POTENTIALLY_INAPPROPRIATE",
    routes: "LLM review",
    rule: "If no earlier rule applies, Hb at or above 10.0 returns POTENTIALLY_INAPPROPRIATE for review. This is not a final INAPPROPRIATE finding.",
  },
];

const thaiTiers: Tier[] = [
  {
    label: "Tier 1",
    range: "Hb ≤ 7.0 ทุก cohort หรือ 7.0 < Hb ≤ เกณฑ์ cohort",
    ruleOutput: "APPROPRIATE",
    routes: "auto-classify",
    rule: "Hb ≤ 7.0 ให้ APPROPRIATE ก่อนตรวจ MTP หรือ cohort ที่ไม่ทราบ หาก Hb สูงกว่า 7.0 แต่ไม่เกินเกณฑ์ cohort จะผ่าน ยกเว้นมี hemodilution หรือ Hb ต่ำครั้งเดียวที่ต้องทบทวน",
  },
  {
    label: "Tier 2",
    range: "เกณฑ์ cohort < Hb < 10 g/dL",
    ruleOutput: "NEEDS_REVIEW",
    routes: "LLM review",
    rule: "เมื่อ Hb สูงกว่าเกณฑ์ cohort แต่ต่ำกว่า 10.0 และไม่เข้าเงื่อนไขก่อนหน้า ระบบให้ NEEDS_REVIEW",
  },
  {
    label: "Tier 3",
    range: "Hb ≥ 10 g/dL",
    ruleOutput: "POTENTIALLY_INAPPROPRIATE",
    routes: "LLM review",
    rule: "หากไม่เข้าเงื่อนไขก่อนหน้า Hb ตั้งแต่ 10.0 ให้ POTENTIALLY_INAPPROPRIATE เพื่อทบทวน ยังไม่ใช่ผลสรุปว่า INAPPROPRIATE",
  },
];

const defaultTiers = isThai ? thaiTiers : englishTiers;
const { tiers = defaultTiers } = Astro.props;

const pillClass = (c: Tier["ruleOutput"]) =>
  c === "APPROPRIATE" ? "ba-pill ba-pill--ok"
  : c === "POTENTIALLY_INAPPROPRIATE" ? "ba-pill ba-pill--err"
  : "ba-pill ba-pill--warn";

const routesPill = (r: Tier["routes"]) =>
  r === "auto-classify" ? "ba-pill ba-pill--ok" : "ba-pill ba-pill--warn";

const routeText = (r: Tier["routes"]) => {
  if (!isThai) return r;
  return r === "auto-classify" ? "จำแนกอัตโนมัติ" : "ส่ง LLM review";
};

const tierNumber = (label: string) => label.replace(/[^0-9]/g, "") || "?";
---

<section class="hb-matrix" aria-label={isThai ? "นโยบาย classification แบบ 3-tier Hb" : "3-tier Hb classification policy"}>
  <div class="hb-matrix__table-wrap">
    <table class="hb-matrix__table">
      <thead>
        <tr>
          <th scope="col" class="hb-matrix__th-tier">Tier</th>
          <th scope="col">{isThai ? "ช่วง Hb" : "Hb range"}</th>
          <th scope="col">{isThai ? "ผลจาก rule" : "Rule output"}</th>
          <th scope="col">{isThai ? "เส้นทาง" : "Routing"}</th>
          <th scope="col">{isThai ? "คำอธิบาย rule" : "Rule"}</th>
        </tr>
      </thead>
      <tbody>
        {tiers.map((t) => (
          <tr>
            <th scope="row" class="hb-matrix__tier-cell">
              <span class="hb-matrix__tier-number" aria-hidden="true">
                {tierNumber(t.label)}
              </span>
              <span class="hb-matrix__tier-label">{t.label}</span>
            </th>
            <td class="hb-matrix__range">{t.range}</td>
            <td><span class={pillClass(t.ruleOutput)}>{t.ruleOutput}</span></td>
            <td><span class={routesPill(t.routes)}>{routeText(t.routes)}</span></td>
            <td class="hb-matrix__rule">{t.rule}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="hb-matrix__note">
    {isThai ? (
      <>
        ตารางนี้แสดงช่วง Hb หลังตรวจการยกเว้นและกฎที่มาก่อนแล้ว
        Vital signs ใช้ประกอบการทบทวน ไม่ทำให้เกิด deterministic bypass ด้วยตัวเอง
      </>
    ) : (
      <>
        These ranges apply after earlier exclusions and routing rules.
        Vital signs support review but do not create a deterministic bypass on their own.
      </>
    )}
  </p>
</section>

<style>
  .hb-matrix {
    margin: 1.25rem 0;
  }
  .hb-matrix__table-wrap {
    overflow-x: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.625rem;
    background: var(--sl-color-bg-nav);
  }
  .hb-matrix__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    margin: 0;
  }
  .hb-matrix__table th,
  .hb-matrix__table td {
    padding: 0.625rem 0.75rem;
    text-align: left;
    vertical-align: top;
    line-height: 1.5;
    border-bottom: 1px solid var(--sl-color-gray-6);
  }
  .hb-matrix__table tbody tr:last-child th,
  .hb-matrix__table tbody tr:last-child td {
    border-bottom: 0;
  }
  .hb-matrix__table tbody tr:nth-child(even) {
    background: color-mix(in oklch, var(--sl-color-gray-6) 50%, transparent);
  }
  .hb-matrix__table thead th {
    background: var(--sl-color-gray-6);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--sl-color-gray-2);
  }
  .hb-matrix__th-tier {
    width: 6.5rem;
  }
  .hb-matrix__tier-cell {
    font-weight: 600;
    color: var(--sl-color-white);
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .hb-matrix__tier-number {
    font-family: var(--ba-font-mono);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--sl-color-accent);
    line-height: 1;
  }
  .hb-matrix__tier-label {
    font-size: 0.8125rem;
    color: var(--sl-color-gray-2);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 600;
  }
  .hb-matrix__range {
    color: var(--sl-color-gray-2);
    font-feature-settings: "tnum" 1;
  }
  .hb-matrix__rule {
    color: var(--sl-color-gray-2);
    max-width: 36rem;
  }
  .hb-matrix__note {
    margin: 0.875rem 0 0;
    font-size: 0.9rem;
    color: var(--sl-color-gray-2);
    line-height: 1.55;
  }
</style>
